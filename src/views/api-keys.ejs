<%- include('partials/head') %>

<div class="app-layout">
    <%- include('partials/sidebar') %>

    <main class="main-content">
        <div class="page-header">
            <h2><i class="bi bi-key" style="color:var(--accent)"></i> API Key Management</h2>
            <span class="badge" style="background:rgba(239,68,68,0.15);color:#ef4444;padding:4px 10px;border-radius:6px;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.5px;">Admin Only</span>
        </div>

        <!-- Generate Key -->
        <div class="content-section">
            <div class="section-title">
                <i class="bi bi-plus-circle"></i> Generate New API Key
            </div>
            <div id="keyError" class="alert alert-error" style="display:none;"></div>
            <div id="keySuccess" class="alert alert-success" style="display:none;"></div>
            <div class="form-row">
                <div class="form-group">
                    <label>Client Name</label>
                    <input type="text" id="clientName" placeholder="e.g. AR Client v2">
                </div>
            </div>
            <div class="form-group" style="margin-bottom:16px;">
                <label>Permissions</label>
                <div style="display:flex;gap:16px;flex-wrap:wrap;">
                    <label style="display:flex;align-items:center;gap:6px;font-size:14px;color:var(--text-secondary);cursor:pointer;">
                        <input type="checkbox" class="perm-check" value="read:alumni" checked> read:alumni
                    </label>
                    <label style="display:flex;align-items:center;gap:6px;font-size:14px;color:var(--text-secondary);cursor:pointer;">
                        <input type="checkbox" class="perm-check" value="read:analytics" checked> read:analytics
                    </label>
                    <label style="display:flex;align-items:center;gap:6px;font-size:14px;color:var(--text-secondary);cursor:pointer;">
                        <input type="checkbox" class="perm-check" value="read:alumni_of_day" checked> read:alumni_of_day
                    </label>
                </div>
            </div>
            <button class="btn btn-primary" id="generateKeyBtn">
                <i class="bi bi-key"></i> Generate Key
            </button>
        </div>

        <!-- Generated Key Display -->
        <div class="content-section" id="newKeyDisplay" style="display:none;">
            <div class="section-title" style="color:var(--success);">
                <i class="bi bi-check-circle"></i> Key Generated — Copy Now!
            </div>
            <div style="background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:16px;font-family:monospace;font-size:14px;word-break:break-all;" id="newKeyValue"></div>
            <p style="font-size:12px;color:var(--warning);margin-top:8px;">
                <i class="bi bi-exclamation-triangle"></i> This key will NOT be shown again. Copy it now!
            </p>
        </div>

        <!-- Existing Keys -->
        <div class="page-header" style="position:static;border-top:1px solid var(--border);">
            <h2>Existing API Keys</h2>
        </div>

        <div id="keysList">
            <div class="content-section" style="text-align:center;padding:40px;">
                <div class="spinner" style="margin:0 auto 12px;"></div>
                <span style="color:var(--text-secondary)">Loading keys...</span>
            </div>
        </div>
    </main>
</div>

<script>
    if (!localStorage.getItem('token')) window.location.href = '/login';
    window.__API_KEY__ = '<%= apiKey %>';
</script>
<script src="/js/apikeys.js"></script>
</body>
</html>
