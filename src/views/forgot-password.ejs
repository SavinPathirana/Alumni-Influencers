<%- include('partials/head') %>

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <i class="bi bi-shield-lock auth-icon"></i>
            <h1>Forgot Password</h1>
            <p>Enter your email to receive a reset token</p>
        </div>

        <div id="authError" class="alert alert-error" style="display:none;"></div>
        <div id="authSuccess" class="alert alert-success" style="display:none;"></div>

        <form id="forgotForm" class="auth-form">
            <div class="form-group">
                <label for="email">Email Address</label>
                <div class="input-wrapper">
                    <i class="bi bi-envelope"></i>
                    <input type="email" id="email" name="email" placeholder="you@eastminster.ac.uk" required>
                </div>
            </div>

            <button type="submit" class="btn btn-primary btn-block" id="forgotBtn">
                <span>Send Reset Token</span>
                <i class="bi bi-send"></i>
            </button>
        </form>

        <div class="auth-footer" style="margin-top:16px;">
            <p>Already have a reset token? <a href="/reset-password">Reset password here</a></p>
            <p style="margin-top:8px;"><a href="/login">Back to Login</a></p>
        </div>
    </div>
</div>

<script>
document.getElementById('forgotForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = document.getElementById('email').value;
    const errorDiv = document.getElementById('authError');
    const successDiv = document.getElementById('authSuccess');
    const btn = document.getElementById('forgotBtn');

    errorDiv.style.display = 'none';
    successDiv.style.display = 'none';
    btn.disabled = true;
    btn.innerHTML = '<span>Sending...</span>';

    try {
        const res = await fetch('/api/auth/forgot-password', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'x-api-key': localStorage.getItem('apiKey') || ''
            },
            body: JSON.stringify({ email })
        });
        const data = await res.json();

        if (res.ok) {
            successDiv.textContent = data.message || 'Reset token sent! Check your email.';
            successDiv.style.display = 'block';
        } else {
            errorDiv.textContent = data.error || 'Failed to send reset token.';
            errorDiv.style.display = 'block';
        }
    } catch (err) {
        errorDiv.textContent = 'Network error. Please try again.';
        errorDiv.style.display = 'block';
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<span>Send Reset Token</span><i class="bi bi-send"></i>';
    }
});
</script>
</body>
</html>
