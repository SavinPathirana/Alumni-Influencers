<%- include('partials/head') %>

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <i class="bi bi-mortarboard-fill auth-icon"></i>
            <h1>Alumni Influencers</h1>
            <p>Sign in to access the analytics dashboard</p>
        </div>

        <div id="authError" class="alert alert-error" style="display:none;"></div>
        <div id="authSuccess" class="alert alert-success" style="display:none;"></div>

        <form id="loginForm" class="auth-form">
            <div class="form-group">
                <label for="email">Email Address</label>
                <div class="input-wrapper">
                    <i class="bi bi-envelope"></i>
                    <input type="email" id="email" name="email" placeholder="you@westminster.ac.uk" required>
                </div>
            </div>

            <div class="form-group">
                <label for="password">Password</label>
                <div class="input-wrapper">
                    <i class="bi bi-lock"></i>
                    <input type="password" id="password" name="password" placeholder="Enter your password" required>
                </div>
            </div>

            <button type="submit" class="btn btn-primary btn-block" id="loginBtn">
                <span>Sign In</span>
                <i class="bi bi-arrow-right"></i>
            </button>
        </form>

        <div class="auth-footer">
            <p>Don't have an account? <a href="/register">Register here</a></p>
        </div>
    </div>
</div>

<script src="/js/auth.js"></script>
</body>
</html>
