<%- include('partials/head') %>

<div class="app-layout">
    <%- include('partials/sidebar') %>

    <main class="main-content">
        <div class="page-header">
            <h2><i class="bi bi-building" style="color:#a855f7"></i> Create Sponsor Account</h2>
            <span class="badge" style="background:rgba(239,68,68,0.15);color:#ef4444;padding:4px 10px;border-radius:6px;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.5px;">Admin Only</span>
        </div>

        <div class="content-section">
            <div id="sponsorError" class="alert alert-error" style="display:none;"></div>
            <div id="sponsorSuccess" class="alert alert-success" style="display:none;"></div>

            <div class="form-group">
                <label>Sponsor Organisation Name</label>
                <input type="text" id="sponsorName" placeholder="e.g. AWS Education">
            </div>
            <div class="form-group">
                <label>Login Email</label>
                <input type="email" id="sponsorEmail" placeholder="e.g. sponsor@company.com">
            </div>
            <div class="form-group">
                <label>Password</label>
                <input type="password" id="sponsorPassword" placeholder="Min 8 chars, upper+lower+digit+special">
            </div>

            <button class="btn btn-primary" id="createSponsorBtn" style="background:#a855f7;margin-top:8px;">
                <i class="bi bi-building-add"></i> Create Sponsor Account
            </button>
        </div>
    </main>
</div>

<script>
    if (!localStorage.getItem('token')) window.location.href = '/login';
</script>
<script src="/js/create-sponsor.js"></script>
</body>
</html>
